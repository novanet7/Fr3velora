<?xml version="1.0" encoding="utf-8"?>
<!-- Tidak ada ActionBar → tidak ada nama "fr3velora" di atas.
     FAB bulat menggantikan tombol menu 3-garis; bisa digeser bebas. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D13">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- FAB bulat draggable – posisi awal: pojok kanan bawah -->
    <ImageButton
        android:id="@+id/fabMenu"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="32dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/fab_circle_bg"
        android:src="@drawable/ic_fab_dots"
        android:contentDescription="Menu"
        android:elevation="8dp"
        android:scaleType="center" />

</FrameLayout>
