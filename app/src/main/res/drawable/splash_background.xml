    <item><shape android:shape="rectangle"><solid android:color="#0A0D13" /></shape></item>
    <item android:gravity="center" android:width="120dp" android:height="120dp">
        <bitmap android:src="@drawable/logo" android:gravity="fill" />
    </item>
</layer-list>
